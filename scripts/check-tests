#!/usr/bin/env python3
"""Run focused component tests without publishing unsafe traceback payloads."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

from public_boundary_policy import scan_bytes

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    result = subprocess.run(
        [sys.executable, "-m", "pytest", "--tb=short"],
        cwd=ROOT,
        env={**os.environ, "PYTHONPATH": "src"},
        capture_output=True,
    )
    output = result.stdout + result.stderr
    findings = scan_bytes(output, source="focused-test-output")
    if findings:
        print(f"focused-tests: blocked unsafe-diagnostics exit={result.returncode}")
        return 1
    sys.stdout.buffer.write(output)
    return 0 if result.returncode == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
