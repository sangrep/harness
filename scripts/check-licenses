#!/usr/bin/env python3
"""Verify technical license/provenance consistency without legal acceptance claims."""

from __future__ import annotations

import hashlib
import json
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
EXPRESSION = "AGPL-3.0-or-later OR LicenseRef-Sangrep-Commercial"


def main() -> int:
    try:
        manifest = json.loads((ROOT / "provenance/repository-v1.json").read_text())
        project = tomllib.loads((ROOT / "pyproject.toml").read_text())["project"]
        if (
            manifest["schemaVersion"] != 1
            or manifest["repositoryLicense"] != EXPRESSION
            or manifest["publicationAccepted"] is not False
            or manifest["contributorRightsAccepted"] is not False
            or project["license"] != EXPRESSION
            or project["license-files"] != ["LICENSE", "NOTICE", "LICENSES/*.txt"]
            or project["dependencies"] != ["sangrep-contracts==0.1.0.dev0", "pydantic==2.12.5"]
            or "NO PUBLICATION GRANT YET" not in (ROOT / "LICENSE").read_text()
            or manifest["embeddedThirdPartySource"] != []
        ):
            raise ValueError("classification")
        for item in manifest["licenseTexts"]:
            path = ROOT / item["path"]
            if path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != item["sha256"]:
                raise ValueError("license-digest")
        for generated, source in manifest["generatedCommittedArtifacts"].items():
            if not (ROOT / generated).is_file() or not (ROOT / source).is_file():
                raise ValueError("generator")
        paths = subprocess.run(
            ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
            cwd=ROOT,
            capture_output=True,
            check=True,
        ).stdout.split(b"\0")
        for raw in paths:
            if not raw:
                continue
            path = Path(raw.decode())
            category = path.parts[0] if len(path.parts) > 1 else "."
            if category not in manifest["sourceClassifications"] or (ROOT / path).is_symlink():
                raise ValueError("unclassified-source")
        # The implementation may only claim a reviewed import once its inventory exists.
        imported = json.loads((ROOT / "provenance/engine-import-v1.json").read_text())
        if imported.get("schemaVersion") != 1 or not imported.get("files"):
            raise ValueError("import-provenance")
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError):
        print("license-check: blocked technical-inventory", file=sys.stderr)
        return 1
    print("license-check: passed technical-only publication-acceptance=pending")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
