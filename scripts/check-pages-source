#!/usr/bin/env python3
"""Read-only preflight for a manual, exact-master, default-URL Pages deployment."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = "sangrep/harness"
PAGE_URL = "https://sangrep.github.io/harness/"


def _read_json(endpoint: str) -> object:
    result = subprocess.run(["gh", "api", endpoint], check=True, capture_output=True, text=True)
    return json.loads(result.stdout)


def main() -> int:
    try:
        expected = os.environ.get("REVIEWED_SOURCE_SHA", "")
        if (
            os.environ.get("GITHUB_EVENT_NAME") != "workflow_dispatch"
            or os.environ.get("GITHUB_REPOSITORY") != REPOSITORY
            or os.environ.get("GITHUB_REF") != "refs/heads/master"
            or re.fullmatch(r"[0-9a-f]{40}", expected) is None
            or expected != os.environ.get("GITHUB_SHA")
        ):
            raise ValueError("dispatch-authority")
        checked_out = subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=ROOT, check=True, capture_output=True, text=True
        ).stdout.strip()
        if checked_out != expected:
            raise ValueError("checkout-authority")
        branch = _read_json(f"repos/{REPOSITORY}/git/ref/heads/master")
        if not isinstance(branch, dict) or branch.get("object", {}).get("sha") != expected:
            raise ValueError("master-moved")
        pages = _read_json(f"repos/{REPOSITORY}/pages")
        if (
            not isinstance(pages, dict)
            or pages.get("build_type") != "workflow"
            or pages.get("html_url") != PAGE_URL
            or "cname" not in pages
            or pages.get("cname") is not None
            or pages.get("https_enforced") is not True
        ):
            raise ValueError("pages-destination")
    except (OSError, ValueError, TypeError, AttributeError, subprocess.CalledProcessError):
        print("pages-preflight: blocked source-or-destination", file=sys.stderr)
        return 1
    print(f"pages-preflight: source-and-destination-match source_sha={expected}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
