#!/usr/bin/env python3
"""Build and inspect a local documentation artifact without deployment."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

from public_boundary_policy import scan_path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    build = subprocess.run(
        [sys.executable, "-m", "mkdocs", "build", "--strict"],
        cwd=ROOT,
        capture_output=True,
    )
    if build.returncode:
        print("docs-check: blocked strict-build", file=sys.stderr)
        return 1
    output = ROOT / "work/docs-site"
    # The plain XML sitemap is sufficient; omit its optional compressed duplicate.
    (output / "sitemap.xml.gz").unlink(missing_ok=True)
    pages = tuple(output.rglob("*.html"))
    if not pages or not (output / "index.html").is_file():
        print("docs-check: blocked empty-artifact", file=sys.stderr)
        return 1
    for path in output.rglob("*"):
        if path.is_file() or path.is_symlink():
            findings = scan_path(path, source=f"docs:{path.relative_to(output).as_posix()}")
            if findings:
                print("docs-check: blocked artifact-boundary", file=sys.stderr)
                return 1
    print(f"docs-check: passed pages={len(pages)} preview=work/docs-site")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
