#!/usr/bin/env bash
set -euo pipefail

readonly GITLEAKS_VERSION="8.30.1"
temporary_root=""
gitleaks_binary=""
scan_output=""
path_inventory=""
asset=""
expected_archive_sha=""
expected_binary_sha=""

cleanup() {
  if [[ -n "$temporary_root" && -d "$temporary_root" ]]; then
    rm -rf -- "$temporary_root"
  fi
  if [[ -n "$scan_output" && -f "$scan_output" ]]; then
    rm -f -- "$scan_output"
  fi
  if [[ -n "$path_inventory" && -f "$path_inventory" ]]; then
    rm -f -- "$path_inventory"
  fi
}
trap cleanup EXIT

blocked() {
  printf 'secret-scan: blocked category=%s\n' "$1" >&2
  exit 1
}

sha_matches() {
  python3 - "$1" "$2" <<'PY'
from __future__ import annotations

import hashlib
import hmac
import sys
from pathlib import Path

actual = hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest()
raise SystemExit(0 if hmac.compare_digest(actual, sys.argv[2]) else 1)
PY
}

select_platform() {
  local operating_system architecture
  operating_system=$(uname -s)
  architecture=$(uname -m)
  case "$operating_system/$architecture" in
    Darwin/arm64)
      asset="gitleaks_${GITLEAKS_VERSION}_darwin_arm64.tar.gz"
      expected_archive_sha="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
      expected_binary_sha="ba52fb1bfabbcde42f032afad3d6e0b19dff8ed105229a16e7caa338bbc0e84f"
      ;;
    Darwin/x86_64)
      asset="gitleaks_${GITLEAKS_VERSION}_darwin_x64.tar.gz"
      expected_archive_sha="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
      expected_binary_sha="cee01fea7173f1b779dff188e1c26ecbcb4027d394acc573b23aaf0be260e291"
      ;;
    Linux/aarch64 | Linux/arm64)
      asset="gitleaks_${GITLEAKS_VERSION}_linux_arm64.tar.gz"
      expected_archive_sha="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
      expected_binary_sha="00e91bbe655bd7c47753e8cfe61cb76ea1a5d7e7702fe161ee40102b46b3823b"
      ;;
    Linux/x86_64 | Linux/amd64)
      asset="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
      expected_archive_sha="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
      expected_binary_sha="88f91962aa2f93ac6ab281d553b9e125f5197bbbce38f9f2437f7299c32e5509"
      ;;
    *) blocked unsupported-platform ;;
  esac
}

binary_is_verified() {
  local candidate="$1"
  [[ -x "$candidate" ]] || return 1
  [[ "$($candidate version 2>/dev/null)" == "$GITLEAKS_VERSION" ]] || return 1
  sha_matches "$candidate" "$expected_binary_sha"
}

resolve_gitleaks() {
  local candidate archive binary
  select_platform
  if [[ -n "${SANGREP_GITLEAKS_TEST_BIN:-}" ]]; then
    if [[ "${SANGREP_GITLEAKS_TEST_MODE:-}" != "true" || -z "${PYTEST_CURRENT_TEST:-}" ]]; then
      blocked test-scanner-forbidden
    fi
    [[ -x "$SANGREP_GITLEAKS_TEST_BIN" ]] || blocked scanner-unavailable
    [[ "$($SANGREP_GITLEAKS_TEST_BIN version 2>/dev/null)" == "$GITLEAKS_VERSION" ]] || \
      blocked scanner-version-mismatch
    gitleaks_binary="$SANGREP_GITLEAKS_TEST_BIN"
    return
  fi
  if [[ -n "${GITLEAKS_BIN:-}" ]]; then
    binary_is_verified "$GITLEAKS_BIN" || blocked scanner-verification-failed
    gitleaks_binary="$GITLEAKS_BIN"
    return
  fi
  if command -v gitleaks >/dev/null 2>&1; then
    candidate=$(command -v gitleaks)
    if binary_is_verified "$candidate"; then
      gitleaks_binary="$candidate"
      return
    fi
  fi

  temporary_root=$(mktemp -d "${TMPDIR:-/tmp}/sangrep-gitleaks.XXXXXX")
  archive="$temporary_root/$asset"
  binary="$temporary_root/gitleaks"
  if ! curl --fail --location --silent \
    "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${asset}" \
    --output "$archive" 2>/dev/null; then
    blocked scanner-download-failed
  fi
  if ! sha_matches "$archive" "$expected_archive_sha"; then
    blocked scanner-verification-failed
  fi
  if ! tar -xzf "$archive" -C "$temporary_root" gitleaks >/dev/null 2>&1; then
    blocked scanner-extraction-failed
  fi
  chmod 0700 "$binary"
  binary_is_verified "$binary" || blocked scanner-verification-failed
  gitleaks_binary="$binary"
}

event_range() {
  python3 - "${GITHUB_EVENT_NAME:-}" "${GITHUB_EVENT_PATH:-}" <<'PY'
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

event_name, event_path = sys.argv[1:]
if event_name not in {"pull_request", "push"} or not event_path:
    raise SystemExit(1)
event = json.loads(Path(event_path).read_text(encoding="utf-8"))
if event_name == "pull_request":
    base = event["pull_request"]["base"]["sha"]
    head = event["pull_request"]["head"]["sha"]
else:
    base = event["before"]
    head = event["after"]
pattern = re.compile(r"[0-9a-f]{40,64}\Z")
if not isinstance(base, str) or not isinstance(head, str):
    raise SystemExit(1)
if not pattern.fullmatch(base) or not pattern.fullmatch(head) or set(base) == {"0"}:
    raise SystemExit(1)
print(f"{base}\t{head}")
PY
}

resolve_gitleaks
scan_output=$(mktemp "${TMPDIR:-/tmp}/sangrep-gitleaks-output.XXXXXX")

run_scan() {
  if ! "$gitleaks_binary" "$@" >"$scan_output" 2>&1; then
    blocked gitleaks-nonzero
  fi
  : >"$scan_output"
}

history_arguments=(git --redact=100 --no-banner --no-color --log-level=error)
if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
  if ! range=$(event_range); then
    blocked event-range-invalid
  fi
  IFS=$'\t' read -r base_sha head_sha <<<"$range"
  git cat-file -e "${base_sha}^{commit}" 2>/dev/null || blocked base-commit-unavailable
  git cat-file -e "${head_sha}^{commit}" 2>/dev/null || blocked head-commit-unavailable
  history_arguments+=("--log-opts=${base_sha}..${head_sha}")
else
  history_arguments+=(--staged)
fi
history_arguments+=(.)
run_scan "${history_arguments[@]}"

path_inventory=$(mktemp "${TMPDIR:-/tmp}/sangrep-gitleaks-paths.XXXXXX")
if ! git diff --name-only --diff-filter=ACMR -z >"$path_inventory"; then
  blocked working-output-inventory-failed
fi
if ! git ls-files --others --exclude-standard -z >>"$path_inventory"; then
  blocked working-output-inventory-failed
fi
if ! generated_roots=$(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts python3 - <<'PY'
from public_boundary_policy import GENERATED_OUTPUT_ROOTS

print("\n".join(GENERATED_OUTPUT_ROOTS))
PY
); then
  blocked working-output-inventory-failed
fi
while IFS= read -r generated_root; do
  [[ -n "$generated_root" ]] || continue
  if [[ -e "$generated_root" || -L "$generated_root" ]]; then
    if ! find "$generated_root" \( -type f -o -type l \) -print0 >>"$path_inventory"; then
      blocked working-output-inventory-failed
    fi
  fi
done <<<"$generated_roots"
while IFS= read -r -d '' working_path; do
  run_scan dir --redact=100 --no-banner --no-color --log-level=error -- "$working_path"
done <"$path_inventory"

rm -f -- "$scan_output"
scan_output=""
rm -f -- "$path_inventory"
path_inventory=""
printf 'secret-scan: passed\n'
